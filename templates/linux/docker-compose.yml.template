version: '3.8'

services:
  frontend_nginx:
    image: nginx:alpine
    container_name: frontend_nginx
    ports:
      - "${NGINX_PORT}:80"
    networks:
      - red_publica
      - red_datos
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
    restart: always

  webapp_interna:
    image: httpd:alpine
    container_name: webapp_interna
    networks:
      - red_publica
      - red_datos
    restart: always

  db_postgres:
    image: postgres:15-alpine
    container_name: db_postgres
    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
    networks:
      - red_datos
    volumes:
      - pg_data:/var/lib/postgresql/data
    restart: always
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}"]
      interval: 10s
      timeout: 5s
      retries: 5

  pgadmin:
    image: dpage/pgadmin4
    container_name: panel_pgadmin
    environment:
      PGADMIN_DEFAULT_EMAIL: ${PGADMIN_DEFAULT_EMAIL}
      PGADMIN_DEFAULT_PASSWORD: ${PGADMIN_DEFAULT_PASSWORD}
    ports:
      - "127.0.0.1:8080:80"
    networks:
      - red_datos
      - red_publica
    restart: always
    depends_on:
      db_postgres:
        condition: service_healthy

networks:
  red_publica:
    driver: bridge
  red_datos:
    driver: bridge
    internal: true

volumes:
  pg_data:
    name: db_volumen_persistente
